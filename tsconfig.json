{
  /*
   * [INPUT]: 依赖 Next.js/React TypeScript 类型与 src/ 源码
   * [OUTPUT]: 对外提供 strict、Bundler 模块解析与 @/* 路径别名
   * [POS]: 根目录的 TypeScript 编译契约，被 Next.js、Vitest 与编辑器共享
   * [PROTOCOL]: 变更时更新此头部，然后检查 README.md
   */
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist"
  ]
}
